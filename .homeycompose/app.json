		"deleteTrackPoint": {
			"method": "POST",
			"path": "/tracks/delete-point",
			"public": false
		},
		"setAvatar": {
			"method": "POST",
			"path": "/avatar",
			"public": false
		},
		"getSettingsBackup": {
			"method": "GET",
			"path": "/settings/backup",
			"public": false
		},
		"restoreSettingsBackup": {
			"method": "POST",
			"path": "/settings/restore",
			"public": false
		},
		"getWaypoints": {
			"method": "GET",
			"path": "/waypoints",
			"public": false
		},
		"getWaypointConfiguration": {
			"method": "GET",
			"path": "/waypoints/configuration",
			"public": false
		},
		"addWaypoint": {
			"method": "POST",
			"path": "/waypoints",
			"public": false
		},
		"updateWaypoint": {
			"method": "POST",
			"path": "/waypoints/update",
			"public": false
		},
		"removeScopedWaypoint": {
			"method": "POST",
			"path": "/waypoints/delete",
			"public": false
		},
		"setSharedWaypointEnabled": {
			"method": "POST",
			"path": "/waypoints/shared-enabled",
			"public": false
		},
		"movePrivateWaypointToShared": {
			"method": "POST",
			"path": "/waypoints/move-to-shared",
			"public": false
		},
		"copyPrivateWaypoint": {
			"method": "POST",
			"path": "/waypoints/copy",
			"public": false
		},
		"deleteWaypoint": {
			"method": "DELETE",
			"path": "/waypoints/:desc",
			"public": false
		},
		"getConnectionStatus": {
			"method": "GET",
			"path": "/connection-status",
			"public": false
		},
		"getLogs": {
			"method": "GET",
			"path": "/logs",
			"public": false
