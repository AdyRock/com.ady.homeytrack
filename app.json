{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.ady.homeytrack",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Homey Tracks"
  },
  "description": {
    "en": "Keep track of the family with the OwnTrack app"
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "author": {
    "name": "RockSoft Solutions",
    "email": "ady@rockalls.uk"
  },
  "api": {
    "events": {
      "method": "POST",
      "path": "/events/:userId",
      "public": true
    },
    "getUsers": {
      "method": "GET",
      "path": "/users",
      "public": false
    },
    "setAvatar": {
      "method": "POST",
      "path": "/avatar",
      "public": false
    },
    "getWaypoints": {
      "method": "GET",
      "path": "/waypoints",
      "public": false
    },
    "addWaypoint": {
      "method": "POST",
      "path": "/waypoints",
      "public": false
    },
    "deleteWaypoint": {
      "method": "DELETE",
      "path": "/waypoints/:desc",
      "public": false
    },
    "getConnectionStatus": {
      "method": "GET",
      "path": "/connection-status",
      "public": false
    },
    "getLogs": {
      "method": "GET",
      "path": "/logs",
      "public": false
    },
    "clearLogs": {
      "method": "DELETE",
      "path": "/logs",
      "public": false
    },
    "emailLogs": {
      "method": "POST",
      "path": "/logs/email",
      "public": false
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "zone_changed",
        "title": {
          "en": "Zone changed"
        },
        "titleFormatted": {
          "en": "Zone changed to [[zone]]"
        },
        "tokens": [
          {
            "name": "zone",
            "type": "string",
            "title": {
              "en": "zone"
            },
            "example": {
              "en": "Home"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=user"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "User"
      },
      "class": "sensor",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "alarm_presence",
        "zone",
        "measure_battery",
        "last_seen"
      ],
      "capabilitiesOptions": {
        "zone": {
          "title": {
            "en": "Zone"
          }
        }
      },
      "settings": [
        {
          "id": "userId",
          "type": "text",
          "label": {
            "en": "OwnTracks / MQTT username (User ID)"
          },
          "hint": {
            "en": "For HTTP mode, this is used in the endpoint URL below. For MQTT mode, it must match either the phone's OwnTracks broker Username, or (if all phones share one broker login) its 'Device ID' instead - whichever is unique per person. Changing this also updates the HTTP endpoint URL below."
          },
          "value": ""
        },
        {
          "id": "httpEndpoint",
          "type": "label",
          "label": {
            "en": "HTTP endpoint URL"
          },
          "hint": {
            "en": "If using HTTP mode, configure the OwnTracks app to post location updates to this URL."
          },
          "value": ""
        },
        {
          "id": "presenceZones",
          "type": "text",
          "label": {
            "en": "Presence zones"
          },
          "hint": {
            "en": "Comma-separated list of OwnTracks region/waypoint names that count as 'present' for the Presence alarm (case-insensitive). Defaults to 'Home' if left blank."
          },
          "value": ""
        }
      ],
      "pair": [
        {
          "id": "add_user",
          "navigation": {
            "next": "done"
          }
        },
        {
          "id": "done"
        }
      ],
      "id": "user"
    }
  ],
  "capabilities": {
    "last_seen": {
      "type": "string",
      "title": {
        "en": "Last seen"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/last_seen.svg"
    },
    "zone": {
      "type": "string",
      "title": {
        "en": "Zone"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/zone.svg"
    }
  }
}